## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# Rider
.idea/

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
.nuget/
*.nuget.props
*.nuget.targets

# Dotnet Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Publish output
*.Publish.xml
*.pubxml
*.publishproj

# Azure
PublishScripts/

# Resharper
_ReSharper*/
*.DotSettings.user

# NUnit / Test Results
TestResult*/
*.trx
*.coverage

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IIS Express
/.vs/
/iisexpress/
*.config.user

# SQL Server files
*.mdf
*.ldf

# Entity Framework migrations snapshot backups
*.bak

# Temporary files
*.tmp
*.temp

# JetBrains Rider
*.sln.iml

# Node (if frontend inside project)
node_modules/

# Environment variables
.env
.env.*

# Secrets
secrets.json

# Coverage
coverage/

# Generated files
Generated_Code/

# Publish folder
publish/

.claude/